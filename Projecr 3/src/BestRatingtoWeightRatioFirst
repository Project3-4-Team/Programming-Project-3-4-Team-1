import java.util.Arrays;
/** 
 * Implements the Best Rating-to-Weight Ratio First greedy strategy.
 * This class sorts the experiments in descending order based on their score 
 * (rating divided by weight) and selects items sequentially until 
 * the weight limit is reached. 
 * 
 * Team Name: Team 1
 * Team Members: Moriancumer Hurtado (primary author), 
 * 				 Jacob Gorham, 
 * 				 Mubarak Alrashdi,
 * 				 Luis Agramonte Peralta
 * Course: CS 2430-502, Fall 2026
 * Project: Programming Project 3
 * 
 */
public class BestRatingtoWeightRatioFirst {
	
	/**
	 * Executes the Best Rating-to-Weight Ratio First greedy selection strategy.
	 * Sorts a copy of the provided array in descending order by floating-point ratio
	 * ({@code rating / weightKg}), breaking ties by descending rating, and selects experiments
	 * that fit within the weight limit before printing a formatted report.
	 * 
	 * @param experiments	an array of Experiment objects to evaluate and sort
	 * @param weightLimit	weight limit in kilograms
	 */
	public static void use(Experiment[] experiments, double weightLimit) {		
			RevisedRules.validateInputs(experiments, weightLimit);
		
			Experiment[] sorted = experiments.clone();
		
			Arrays.sort(sorted, (a, b) -> {
				double scoreA = (double) a.getRating() / a.getWeightKg();
	            double scoreB = (double) b.getRating() / b.getWeightKg();
	            
	            int ratioComparison = Double.compare(scoreB, scoreA);
				return (ratioComparison != 0) ? ratioComparison : 
					Integer.compare(b.getRating(), a.getRating());
	        });
	
			
			double currentWeightKg = 0;
			int totalRating = 0;
			
			System.out.println();
			System.out.println("Best Rating-to-Weight Ratio First's Chosen Experiments");
			System.out.println();
			
			for(Experiment e : sorted) {
				if (currentWeightKg + e.getWeightKg() <= weightLimit) {
					currentWeightKg += e.getWeightKg();
					totalRating += e.getRating();
					
					double score = (double) e.getRating() / e.getWeightKg();
					
					System.out.printf("- %-26s (Weight: %.1f kg, Rating: %d, Ratio: %.4f)%n", 
	                        e.getExperimentName(), e.getWeightKg(), e.getRating(), score);
				}
			}
			
			System.out.println();
			System.out.printf("Total Weight: %.1f kg / %.1f kg%n", currentWeightKg, weightLimit);
			System.out.println("Total Rating: " + totalRating);
			System.out.println();
				
		}
	
	// Order Change (helper class)
	
	/**
	 * Executes the Best Rating-to-Weight Ratio First greedy strategy under the Week 3 revised rules.
	 * Ranking Rule: Computes each experiment's floating-point ratio (rating / weightKg)
	 * and sorts in descending order, breaking identical ratio ties by descending rating.
	 * Each tentative addition is evaluated by RevisedRules using adjusted mass and prerequisite rules.
	 *
	 * @param experiments 		an array of Experiment objects to evaluate and sort
	 * @param weightLimit 		weight limit in kilograms
	 */
	public static void revisedRuleUse(Experiment[] experiments, double weightLimit) {
		RevisedRules.validateInputs(experiments, weightLimit);
		
		Experiment[] sorted = experiments.clone();
	
		Arrays.sort(sorted, (a, b) -> {
			double scoreA = (double) a.getRating() / a.getWeightKg();
            double scoreB = (double) b.getRating() / b.getWeightKg();
            
            int ratioComparison = Double.compare(scoreB, scoreA);
			return (ratioComparison != 0) ? ratioComparison : 
				Integer.compare(b.getRating(), a.getRating());
        });

		RevisedRules newRules = new RevisedRules(weightLimit);
		for (Experiment e: sorted) {
			newRules.revisedUse(e);
		}
		
		
		newRules.printReport("Best Rating-to-Weight Ratio First's Chosen Experiments", true);
			
	}

}
