/**
 * Creates an Experiment object for project 3:Knapsack Problem. 
 * Each experiment has an order number, a name, its weight in kilograms
 * and a value rating. 
 * 
 * Team Name: Team 1
 * Team Members: Moriancumer Hurtado (primary author), 
 * 				 Jacob Gorham, 
 * 				 Mubarak Alrashdi,
 * 				Luis Agramonte Peralta
 * Course: CS 2430-502, Fall 2026
 * Project: Programming Project 3
 */
public class Experiment {
	private String order;
	private String experimentName;
	private double weightKg;
	private int rating;
	

	/**
	 * Constructs a new Experiment with an order number, 
	 * name, its weight in kilograms and a value rating 
	 * 
	 * @param order				the order number of the experiment as a String. 
	 * @param experimentName	the name of the experiment as a String.
	 * @param weightKg			the weight of the experiment in kilograms as a double.
	 * @param rating			the rating of the experiment as an int.
	 */
	public Experiment(String order, String experimentName, double weightKg, int rating) {
		setOrder(order);
		setExperimentName(experimentName);
		setWeightKg(weightKg);
		setRating(rating); 	
	}

	public String getOrder() {
		return order;
	}

	public void setOrder(String order) {
		if (order == null || order.trim().isEmpty()) {
			throw new IllegalArgumentException("Experiment order cannot be null or blank.");
		}
		this.order = order;
	}

	public String getExperimentName() {
		return experimentName;
	}

	public void setExperimentName(String experimentName) {
		if (experimentName == null || experimentName.trim().isEmpty()) {
			throw new IllegalArgumentException("Experiment name cannot be null or blank.");
		}
		this.experimentName = experimentName;
	}

	public double getWeightKg() {
		return weightKg;
	}

	public void setWeightKg(double weightKg) {
		if (weightKg <= 0) {
			throw new IllegalArgumentException("Experiment weight must be greater than 0 kg.");
		}
		this.weightKg = weightKg;
	}

	public int getRating() {
		return rating;
	}

	public void setRating(int rating) {
		if (rating < 0) {
			throw new IllegalArgumentException("Experiment rating cannot be negative.");
		}
		this.rating = rating;
	}
	
	/**
	 * Returns a formatted string representation of the experiment:
	 * Experiment #{order}: {experimentName} (Weight: {weightKg}, Rating: {rating})
	 */
	@Override
	public String toString() {
		return String.format("Experiment #%s: %-30s (Weight: %.1f, Rating: %d)", 
				order, experimentName, weightKg, rating);
	}
	
}
