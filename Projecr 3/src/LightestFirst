import java.util.Arrays;

/**
 * Implements the Lightest First greedy strategy for Project 3: Knapsack Problem.
 * Sorts experiments in ascending order by weight (with higher rating as a tie-breaker)
 * and selects items sequentially until the weight limit is reached.
 * 
 * Team Name: Team 1
 * Team Members: Moriancumer Hurtado,
 *               Jacob Gorham,
 *               Mubarak Alrashdi,
 *               Luis Agramonte Peralta
 * Course: CS 2430-502, Fall 2026
 * Project: Programming Project 3
 */
public class LightestFirst {
	
	/**
	 * Executes the Lightest First greedy selection strategy.
	 * Sorts a copy of the array in ascending order by weight (breaking ties by
	 * higher rating first), adds experiments that fit within the weight limit,
	 * and prints a formatted summary report.
	 * 
	 * @param experiments	an array of Experiment objects to evaluate and sort
	 * @param weightLimit	weight limit in kilograms
	 */
	
	public static void use(Experiment[] experiments, double weightLimit) {
			RevisedRules.validateInputs(experiments, weightLimit);
		
			Experiment[] sorted = experiments.clone();
		
			Arrays.sort(sorted, (a, b) -> {
				int weightComparison = Double.compare(a.getWeightKg(), b.getWeightKg());
				return (weightComparison != 0) ? weightComparison : Integer.compare(b.getRating(), a.getRating());
			});
			
			double currentWeightKg = 0;
			int totalRating = 0;
			
			System.out.println();
			System.out.println("Lightest First's Chosen Experiments");
			System.out.println();
			
			for(Experiment e : sorted) {
				if (currentWeightKg + e.getWeightKg() <= weightLimit) {
					currentWeightKg += e.getWeightKg();
					totalRating += e.getRating();
					System.out.printf("- %-26s (Weight: %.1f kg, Rating: %d)%n", 
	                        e.getExperimentName(), e.getWeightKg(), e.getRating());
				}
			}
			
			System.out.println();
			System.out.printf("Total Weight: %.1f kg / %.1f kg%n", currentWeightKg, weightLimit);
			System.out.println("Total Rating: " + totalRating);
			System.out.println();
				
		}

	// Order Change (helper class)
	
	/**
	 * Executes the Lightest First greedy strategy under the Week 3 revised rules.
	 * Ranking Rule: Sorts experiments in ascending order by weight, breaking ties by
	 * descending rating (higher rating first). Each tentative addition is evaluated
	 * by RevisedRules using adjusted mass and prerequisite rules.
	 *
	 * @param experiments 		an array of Experiment objects to evaluate and sort
	 * @param weightLimit 		weight limit in kilograms
	 */
	public static void revisedRuleUse(Experiment[] experiments, double weightLimit) {
		RevisedRules.validateInputs(experiments, weightLimit);	
		
		Experiment[] sorted = experiments.clone();
		
		Arrays.sort(sorted, (a, b) -> {
			int weightComparison = Double.compare(a.getWeightKg(), b.getWeightKg());
			return (weightComparison != 0) ? weightComparison : Integer.compare(b.getRating(), a.getRating());
		});

		RevisedRules newRules = new RevisedRules(weightLimit);
		for (Experiment e: sorted) {
			newRules.revisedUse(e);
		}
								
		newRules.printReport("Lightest First's Chosen Experiments", false);				
	}
}
