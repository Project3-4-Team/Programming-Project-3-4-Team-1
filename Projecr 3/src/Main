/**
 * Test Driver for Programming Project 3 (Knapsack Problem).
 * This class initializes a set of 12 unique experiments, 
 * adds them to an array, and tests three greedy strategies
 * as well as a brute-force exhaustive search—to find    
 * a combination of unique experiments that has 
 * the highest overall rating without exceeding 
 * a specific weight limit.  
 * 
 * Team Name: Team 1
 * Team Members: Moriancumer Hurtado, 
 * 				 Jacob Gorham, 
 * 				 Mubarak Alrashdi,
 * 				 Luis Agramonte Peralta
 * Course: CS 2430-502, Fall 2026
 * Project: Programming Project 3
 *
 * 
 */
public class Main {

	public static void main(String[] args) {
		
		
		// use the Experiment class to add all 12 experiment
		// than puts them in an Experiment array called experiments
		// than prints out the Experiments 
		
		Experiment cloudPatterns = new Experiment("1", "Cloud Patterns", 36, 5); 
		Experiment solarFlares = new Experiment("2", "Solar Flares", 264, 9);
		Experiment solarPower = new Experiment("3", "Solar Power", 188, 6);
		Experiment binaryStars = new Experiment("4", "Binary Stars", 203, 8);
		Experiment relativity = new Experiment("5", "Relativity", 104, 8);
		Experiment seedViability = new Experiment("6", "Seed Viability", 7, 4);
		Experiment sunSpots = new Experiment("7", "Sun Spots", 90, 2);
		Experiment miceTumors = new Experiment("8", "Mice Tumors", 65, 8);
		Experiment microgravityPlantGrowth = new Experiment("9", "Microgravity Plant Growth", 75, 5);
		Experiment micrometeorites = new Experiment("10", "Micrometeorites", 170, 9);
		Experiment cosmicRays = new Experiment("11", "Cosmic Rays", 80, 7);
		Experiment yeastFermentation = new Experiment("12", "Yeast Fermentation", 27, 4);
		
		Experiment[] experiments = {cloudPatterns, solarFlares, solarPower,
									binaryStars, relativity, seedViability,
									sunSpots, miceTumors, microgravityPlantGrowth,
									micrometeorites, cosmicRays, yeastFermentation		
		};
		
		//for (Experiment exp : experiments) {
		   // System.out.println(exp);
		//}
		
		//System.out.println();
		
		// Part 1 – Implement Three Greedy Strategies
		
		double weightLimit = 700;
		
		// Highest Rating First 
		//System.out.println("\n------------------------------------------------");
		//HighestRatingFirst.use(experiments, weightLimit);
		//System.out.println("\n------------------------------------------------");
		
		
		// Lightest First
		//System.out.println("\n------------------------------------------------");
		//LightestFirst.use(experiments, weightLimit);
		//System.out.println("\n------------------------------------------------");
		
		
		// Best Rating-to-Weight Ratio First 
		//System.out.println("\n------------------------------------------------");
		//BestRatingtoWeightRatioFirst.use(experiments, weightLimit);
		//System.out.println("\n------------------------------------------------");
		
		
		// Part 2 – Brute Force / Exhaustive Search
		//System.out.println("\n------------------------------------------------");
		//BruteForce.use(experiments, weightLimit);
		///System.out.println("\n------------------------------------------------");

       // Part 4 - Dynamic Programming (pseudocode)
       // 
       // instead of checking every single subset like brute force,
       // this DP approach will create smaller versions of the actual problem
	   // and save the answers in a table so they can be reused instead of doing
       // the calculation all over again.
       //
       // table[itemNum][space] = the best rating using the first itemNum (experiments) with the space kg of room.
       // 
       // for each experiment itemNum (1 to n): 
       //     for each space (0 to 700):
       //         skip: table[itemNum][space] = table[itemNum - 1][space]
       //         if experiment itemNum fits in space:
       //                 take itemNum: rating[itemNum] + table[itemNum - 1][space - weight[itemNum]]
       //                 keep the highest
       //
       // best answer = table[n][700]  (matches brute force with 53)
       //
       // brute force doubles the work with every new experiment but DP only adds
       // one more row, this makes it stay fast on bigger problems while still getting the best possible result.


		// Project 3: Change Order
		
		// Revised Experiments 
		Experiment rCloudPatterns = new Experiment("1", "Cloud Patterns", 36, 5);
		Experiment rSolarFlares = new Experiment("2", "Solar Flares", 264, 9);
		Experiment rSolarPower = new Experiment("3", "Solar Power", 188, 6);
		Experiment rBinaryStars = new Experiment("4", "Binary Stars", 203, 8);
		Experiment rRelativity = new Experiment("5", "Relativity", 104, 8);
		Experiment rSeedViability = new Experiment("6", "Seed Viability", 7, 4);
		Experiment rSunSpots = new Experiment("7", "Sun Spots", 90, 2);
		Experiment rMiceTumors = new Experiment("8", "Mice Tumors", 65, 8);
		Experiment rMicrogravityPlantGrowth = new Experiment("9", "Microgravity Plant Growth", 75, 5);
		Experiment rMicrometeorites = new Experiment("10", "Micrometeorites", 170, 9);
		Experiment rCosmicRaysPB = new Experiment("11", "Cosmic Rays", 80, 7);
		Experiment rCosmicRaysSB = new Experiment("11a", "Cosmic Rays", 10, 5);
		Experiment rYeastFermentation = new Experiment("12", "Yeast Fermentation", 27, 4);
		
		Experiment[] revisedExperiments = {rCloudPatterns, rSolarFlares, rSolarPower,
										   rBinaryStars,rRelativity, rSeedViability,
										   rSunSpots, rMiceTumors, rMicrogravityPlantGrowth,
										   rMicrometeorites, rCosmicRaysPB, rCosmicRaysSB,
										   rYeastFermentation
		};
		
		System.out.println("\n------------------------------------------------");
		HighestRatingFirst.revisedRuleUse(revisedExperiments, weightLimit);
		System.out.println("\n------------------------------------------------");
		
		System.out.println("\n------------------------------------------------");
		LightestFirst.revisedRuleUse(revisedExperiments, weightLimit);
		System.out.println("\n------------------------------------------------");
		
		System.out.println("\n------------------------------------------------");
		BestRatingtoWeightRatioFirst.revisedRuleUse(revisedExperiments, weightLimit);
		System.out.println("\n------------------------------------------------");
		
		System.out.println("\n------------------------------------------------");
		BruteForce.revisedRuleUse(revisedExperiments, weightLimit);
		System.out.println("\n------------------------------------------------");
		
		System.out.println("\n==================== SUMMARY ====================");
		System.out.println("Optimal Rating (Brute Force): 58 (Weight: 695.0 kg)");
		System.out.println("Matched Optimal:");
		System.out.println("  - None");
		System.out.println("Did Not Match Optimal:");
		System.out.println("  - Lightest First (Rating: 57, Weight: 657.0 kg)");
		System.out.println("  - Best Rating-to-Weight Ratio First (Rating: 57, Weight: 657.0 kg)");
		System.out.println("  - Highest Rating First (Rating: 50, Weight: 700.0 kg)");
		System.out.println("=================================================");
		
	}

}
