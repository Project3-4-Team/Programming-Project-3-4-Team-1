	// BruteForce: All 3 rules 
	@Test
    void testBruteForceRevisedRulesConstraintEnforcement() {
        Experiment[] constrainedSet = {
            new Experiment("2", "Solar Flares", 264, 9),
            new Experiment("3", "Solar Power", 188, 6),
            new Experiment("7", "Sun Spots", 90, 2),
            new Experiment("11a", "Cosmic Rays", 10, 5)
        };

        String output = captureOutput(() -> BruteForce.revisedRuleUse(constrainedSet, 700.0));
        String rank1Block = output.substring(output.indexOf("Rank 1 - OPTIMAL"), output.indexOf("Rank 2"));

        assertTrue(rank1Block.contains("Solar Flares"));
        assertTrue(rank1Block.contains("Solar Power"));
        assertFalse(rank1Block.contains("Sun Spots"), "3rd solar instrument must be rejected");
        assertFalse(rank1Block.contains("Cosmic Rays"), "11a must be rejected when 11 is absent");
        assertTrue(rank1Block.contains("Total Weight: 452.0 kg / 700.0 kg"));
        assertTrue(rank1Block.contains("Total Rating: 15"));
    }
	
