	@Test
    void testIdenticalRatiosResolvedCleanly() {
        Experiment testExperiment10kg = new Experiment("1", "10kg", 10.0, 1);
        Experiment testExperiment20kg = new Experiment("2", "20kg", 20.0, 2);

        Experiment[] testExperiments = { testExperiment10kg, testExperiment20kg };

        // Case A: Capacity fits both (30 kg) -> both selected cleanly, no exceptions or NaN issues
        String bothFit = captureOutput(() -> BestRatingtoWeightRatioFirst.use(testExperiments, 30.0));
        assertTrue(bothFit.contains("10kg"));
        assertTrue(bothFit.contains("20kg"));
        assertTrue(bothFit.contains("Ratio: 0.1000"));
        assertTrue(bothFit.contains("Total Weight: 30.0 kg / 30.0 kg"));
        assertTrue(bothFit.contains("Total Rating: 3"));
        
        String revisedRuleBothFit = captureOutput(() -> BestRatingtoWeightRatioFirst.revisedRuleUse(testExperiments, 30.0));
        assertTrue(revisedRuleBothFit.contains("10kg"));
        assertTrue(revisedRuleBothFit.contains("20kg"));
        assertTrue(revisedRuleBothFit.contains("Ratio: 0.1000"));
        assertTrue(revisedRuleBothFit.contains("Total Weight: 30.0 kg / 30.0 kg"));
        assertTrue(revisedRuleBothFit.contains("Total Rating: 3"));

        // Case B: Capacity only fits 20 kg -> higher-rating tie-breaker selects 20kg (Rating 2) over 10kg (Rating 1)
        String tightFit = captureOutput(() -> BestRatingtoWeightRatioFirst.use(testExperiments, 20.0));
        assertTrue(tightFit.contains("20kg"), "Higher-rating tie-breaker selects 20kg (Rating 2) first");
        assertFalse(tightFit.contains("10kg"), "10kg exceeds remaining 0 kg capacity");
        assertTrue(tightFit.contains("Total Weight: 20.0 kg / 20.0 kg"));
        assertTrue(tightFit.contains("Total Rating: 2"));
        
        String revisedRuleTightFit = captureOutput(() -> BestRatingtoWeightRatioFirst.revisedRuleUse(testExperiments, 20.0));
        assertTrue(revisedRuleTightFit.contains("20kg"), "Higher-rating tie-breaker selects 20kg (Rating 2) first");
        assertFalse(revisedRuleTightFit.contains("10kg"), "10kg exceeds remaining 0 kg capacity");
        assertTrue(revisedRuleTightFit.contains("Total Weight: 20.0 kg / 20.0 kg"));
        assertTrue(revisedRuleTightFit.contains("Total Rating: 2"));
    }

