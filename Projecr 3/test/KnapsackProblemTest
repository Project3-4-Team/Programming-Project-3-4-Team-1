	// HighestRatingFirst: Descending Rating & Lighter Tie-Breaker
	
	@Test
    void testHighestRatingFirstSortingAndLighterTieBreaker() {
        Experiment heavyTie = new Experiment("4", "Heavy Star", 200.0, 8);
        Experiment topRating = new Experiment("10", "Top Meteor", 170.0, 9);
        Experiment lightTie = new Experiment("8", "Light Mice", 65.0, 8);

        Experiment[] items = { heavyTie, topRating, lightTie };

        String baseOut = captureOutput(() -> HighestRatingFirst.use(items, 240.0));
        int idxTop = baseOut.indexOf("Top Meteor");
        int idxLight = baseOut.indexOf("Light Mice");

        assertTrue(idxTop >= 0 && idxLight > idxTop, "Top Meteor (9) must be selected before Light Mice (8)");
        assertFalse(baseOut.contains("Heavy Star"), "Heavy Star (200 kg) must lose the Rating 8 tie to Light Mice (65 kg)");
        assertTrue(baseOut.contains("Total Weight: 235.0 kg / 240.0 kg"));
        assertTrue(baseOut.contains("Total Rating: 17"));

        String revisedOut = captureOutput(() -> HighestRatingFirst.revisedRuleUse(items, 240.0));
        assertTrue(revisedOut.contains("Top Meteor"));
        assertTrue(revisedOut.contains("Light Mice"));
        assertFalse(revisedOut.contains("Heavy Star"));
        assertTrue(revisedOut.contains("Total Rating: 17"));
    }
	
	
